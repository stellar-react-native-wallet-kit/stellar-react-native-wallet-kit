    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "react": "^18.2.0",
    "react-native": "^0.73.6",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
